    RatioRange                          =     0.6;          1.0;      3.0;      6.0;      20.1;     120.1;
    #CameraId[operation_mode]              defaultId
    #
    #COMMON SAT    CameraId=0:0x1(main) CameraId=2:0x4(ultra wide) CameraId=3:0x8(tele)   CameraId=4:0x10(ultra tele)
    CameraId[0x8001]                    =     0x1;          0x4;      0x1;      0x8;      0x10;      0x10
    #
    #30FPS VIDEO
    CameraId[0x830b]                    =     0x0;          0x4;      0x1;      0x8;      0x10;      0x10
    #
    #60FPS VIDEO
