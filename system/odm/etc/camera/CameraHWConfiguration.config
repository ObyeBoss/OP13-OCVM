[Oplus3AMode]
    # Oplus3AMask: oplus 3A algo switch for each sensor name
    # close(0), ID0(0x1), ID1(0x2), ID2(0x4), ID3(0x8),..., all open(0xFF)
    #
    #dodgemain; dodgefront; dodgeultrawide; dodgetele; dodgetele2
    OplusAEMask       = 0xFF;
    #
    #dodgemain; dodgefront; dodgeultrawide; dodgetele; dodgetele2
    OplusAWBMask      = 0xFF;
    #
    #dodgemain; dodgefront; dodgeultrawide; dodgetele; dodgetele2
    OplusAFMask       = 0xFF;
    OplusPDMask       = 0x00;
    #
    #dodgemain; dodgefront; dodgeultrawide; dodgetele; dodgetele2
    OplusLocalAWBMask = 0x1D;
    #
    #ID0(0x1), ID2(0x4), ID3(0x8)
    OplusLocalColorMask = 0x0D;
    OplusAEversion    = 3;
    OplusAWBversion   = 3;
    OplusAFversion    = 3;
    OplusPDversion    = 2;

